# ── Bublik Bot ─────────────────────────────────
# Discord
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_client_id_here
OWNER_ID=
# Comma-separated guild IDs used once to seed an empty database. Further changes
# are managed with /whitelist and persist even when the last guild is removed.
ALLOWED_GUILDS=

# Если указать — команды (кроме глобальных) регистрируются только для этой гильдии
# Для продакшена оставить пустым — тогда guild-команды пушатся при guildCreate
DEV_GUILD_ID=

# ── Database (PostgreSQL) ─────────────────────
# Пароль в URL должен быть percent-encoded, если содержит @, :, /, # и т.п.
DATABASE_URL=postgresql://bublik:change_me_to_a_strong_password@postgres:5432/bublik?schema=public
# Обычный bot service всегда принудительно использует 0. Для единственного
# baseline старой db-push базы передай 1 только явному migration-only контейнеру
# после backup/restore rehearsal; не меняй этот флаг в постоянной .env.
PRISMA_BASELINE_EXISTING=0

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=256mb
BUBLIK_POSTGRES_IMAGE=postgres@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416
BUBLIK_REDIS_IMAGE=redis@sha256:8b81dd37ff027bec4e516d41acfbe9fe2460070dc6d4a4570a2ac5b9d59df065

# ── Bot Settings ──────────────────────────────
DEFAULT_LOCALE=ru
BOT_COLOR=#5865F2
LOG_LEVEL=info
ERROR_CHANNEL_ID=

# ── BR Rotation Test Config ───────────────────
# Тестовое расписание BR на 01.05.2026–30.06.2026.
# Вставь JSON в одну строку или используй /br rotation-update с файлом.
BR_ROTATION_DATA=[{"start":"2026-05-01","end":"2026-05-07","rating":"11.0"},{"start":"2026-05-08","end":"2026-05-14","rating":"10.0"},{"start":"2026-05-15","end":"2026-05-21","rating":"9.0"},{"start":"2026-05-22","end":"2026-05-28","rating":"8.0"},{"start":"2026-05-29","end":"2026-06-04","rating":"7.0"},{"start":"2026-06-05","end":"2026-06-11","rating":"6.0"},{"start":"2026-06-12","end":"2026-06-18","rating":"5.0"},{"start":"2026-06-19","end":"2026-06-25","rating":"4.0"},{"start":"2026-06-26","end":"2026-06-30","rating":"3.0"}]
BR_TEMPLATE_GUILD_ID=1390368736485310472
BR_ROTATION_NOTIFY_CHANNEL_ID=
BR_ROTATION_NOTIFY_ROLE_ID=
BR_ROTATION_NOTIFY_HOUR=12

# ── Environment ───────────────────────────────
NODE_ENV=production
BUBLIK_HEALTH_FILE=/tmp/bublik-health.json
BUBLIK_HEALTH_MAX_AGE_MS=75000

# ── PostgreSQL (Docker Compose) ──────────────
POSTGRES_USER=bublik
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=bublik

# ── Welcome Module (каналы) ───────────────
# Одноразовый импорт старых global ENV-настроек в конкретную guild.
# Обязательно укажите при нескольких ALLOWED_GUILDS; после успешного импорта
# значения в БД становятся авторитетными и ENV больше их не перезаписывает.
WELCOME_LEGACY_GUILD_ID=
# Канал куда отправляется приветствие
WELCOME_CHANNEL_ID=
# Канал тикетов
TICKET_CHANNEL_ID=
# Роль новобранца/кандидата (открывает доступ к каналу тикетов)
RECRUIT_ROLE_ID=
AUTO_ROLE_ID=

# ── Небесные Стражи (только для одной гильдии) ──
NS_GUILD_ID=
