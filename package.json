{
  "name": "bublik-bot",
  "version": "1.0.2",
  "description": "Bublik — модульный Discord-бот с hot-reload, i18n, PostgreSQL & Redis",
  "author": "NaveLIL",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node scripts/clean-build.js",
    "build": "npm run clean && tsc",
    "build:protected": "npm run build && node scripts/obfuscate.js && node scripts/verify-protected-artifact.js",
    "release:export-public": "node scripts/export-public-distribution.js",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"tests/**/*.test.ts\" \"src/**/__tests__/*.test.ts\"",
    "test:integration": "tsx scripts/integration-smoke.ts",
    "test:baseline": "tsx scripts/baseline-verifier-integration.ts",
    "test:data-gate": "tsx scripts/data-gate-ci-integration.ts",
    "data:preflight": "node scripts/snapshot-baseline-data.js --preflight",
    "data:postflight": "node scripts/snapshot-baseline-data.js --postflight",
    "data:snapshot": "node scripts/snapshot-baseline-data.js --snapshot",
    "check": "prisma validate && prisma generate && npm run build && npm run lint && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "docker:up": "docker compose -p bublik-n up -d --build",
    "docker:down": "docker compose -p bublik-n down",
    "docker:logs": "docker compose -p bublik-n logs -f bot"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "prisma": "^5.22.0",
    "rcon-client": "^4.2.5",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "globals": "^15.15.0",
    "javascript-obfuscator": "^4.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
